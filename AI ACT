glossary: [
  { term:"Sistem de IA", article:"art. 3 pct. 1", def:"Un sistem bazat pe mașini, proiectat să funcționeze cu niveluri variabile de autonomie și care poate manifesta capacitate de adaptare după implementare, și care, pentru obiective explicite sau implicite, deduce, din datele de intrare primite, modul de generare a unor rezultate cum ar fi previziuni, conținut, recomandări sau decizii, care pot influența medii fizice sau virtuale." },
  { term:"Furnizor", article:"art. 3 pct. 3", def:"Persoană fizică sau juridică, autoritate publică, agenție sau alt organism care dezvoltă un sistem de IA sau un model de IA de uz general, sau care are dezvoltat un astfel de sistem/model, și îl introduce pe piață sau pune în funcțiune sistemul de IA sub propriul nume/marcă, cu titlu oneros sau gratuit." },
  { term:"Implementator", article:"art. 3 pct. 4", def:"Persoană fizică sau juridică, autoritate publică, agenție sau alt organism care utilizează un sistem de IA sub autoritatea sa, cu excepția cazului în care sistemul este folosit în cadrul unei activități personale cu caracter neprofesional." },
  { term:"Model de IA de uz general (GPAI)", article:"art. 3 pct. 63", def:"Un model de IA, inclusiv atunci când este antrenat cu o cantitate mare de date folosind auto-supravegherea la scară, care prezintă o generalitate semnificativă și este capabil să îndeplinească în mod competent o gamă largă de sarcini distincte, indiferent de modul în care modelul este introdus pe piață, și care poate fi integrat într-o varietate de sisteme sau aplicații din aval." },
  { term:"Punerea pe piață", article:"art. 3 pct. 9", def:"Prima punere la dispoziție a unui sistem de IA sau a unui model de IA de uz general pe piața Uniunii." },
  { term:"Punerea în funcțiune", article:"art. 3 pct. 11", def:"Furnizarea unui sistem de IA pentru prima utilizare directă către implementator sau pentru uz propriu în Uniune, în scopul prevăzut al acestuia." },
  { term:"Risc sistemic", article:"art. 3 pct. 65", def:"Un risc specific capacităților de mare impact ale modelelor de IA de uz general, care are un impact semnificativ asupra pieței Uniunii datorită razei lor de acțiune, ori din cauza efectelor negative reale sau previzibile în mod rezonabil asupra sănătății publice, siguranței, securității publice, drepturilor fundamentale sau asupra societății în ansamblu, ce pot fi propagate la scară largă pe tot lanțul valoric." },
  { term:"Sistem de IA cu risc ridicat", article:"art. 6", def:"Sistem de IA care fie este o componentă de siguranță a unui produs reglementat de legislația UE de armonizare din anexa I, fie se încadrează într-una dintre categoriile de utilizare de sine stătătoare enumerate în anexa III (cu excepțiile aplicabile prevăzute la art. 6 alin. (3))." },
  { term:"Identificare biometrică la distanță", article:"art. 3 pct. 41-42", def:"Identificarea automatizată a unei persoane fizice, la distanță, prin compararea datelor sale biometrice cu datele dintr-o bază de referință, fără implicarea activă a persoanei vizate — poate fi „în timp real” sau „ex-post” (a posteriori)." },
  { term:"Conținut sintetic (deepfake)", article:"art. 3 pct. 60", def:"Conținut de tip imagine, audio sau video generat sau manipulat prin IA, care seamănă considerabil cu persoane, obiecte, locuri, entități sau evenimente existente și care ar putea fi perceput în mod eronat de o persoană ca fiind autentic sau veridic." }
